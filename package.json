{
  "name": "canvas-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build:dev",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint . --no-error-on-unmatched-pattern && pnpm -r --if-present --filter '!canvas-monorepo' run lint",
    "format": "prettier --write \"packages/**/*.{js,md,json}\"",
    "changeset": "changeset",
    "release:extension": "bash scripts/update-releases.sh extension",
    "release:desktop": "bash scripts/update-releases.sh desktop",
    "release:all": "bash scripts/update-releases.sh all",
    "publish:npm": "node scripts/publish-npm.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
