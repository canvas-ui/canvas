# KIO service menu — adds "Send to Canvas" to Dolphin's right-click menu for
# any file. Install to ~/.local/share/kio/servicemenus/ (see install.sh).
[Desktop Entry]
Type=Service
MimeType=all/allfiles;
Actions=sendToCanvas;
X-KDE-Priority=TopLevel

[Desktop Action sendToCanvas]
Name=Send to Canvas
Icon=document-send
Exec=canvas-share %F
