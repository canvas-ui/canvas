#!/usr/bin/env python3
"""Send files, links or text snippets to a Canvas server from the desktop.

Stdlib-only (python3 + curl-free); pairs with the KIO service menu
(canvas-share.desktop) for Dolphin's context menu and with a Klipper action /
global shortcut for selected text. See README.md alongside this script.

Usage:
  canvas-share FILE [FILE...]      upload files into the workspace blob store
  canvas-share --text "snippet"    save a text snippet as a note
  canvas-share --selection         save the current primary selection (needs
                                   wl-paste or xclip) — bare URLs become links
  echo "..." | canvas-share --text -   read the snippet from stdin

Config (~/.config/canvas/share.conf, KEY=VALUE lines):
  CANVAS_URL=http://127.0.0.1:8001   server base URL (no trailing /rest/v2)
  CANVAS_TOKEN=canvas-...            API token (Settings > API tokens)
  CANVAS_WORKSPACE=universe          target workspace name
  CANVAS_PATH=/inbox                 tree path documents land on (default /)
  CANVAS_TREE=context                tree name (default context tree)
"""

import json
import mimetypes
import os
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

CONF = Path.home() / '.config' / 'canvas' / 'share.conf'


def die(msg, code=1):
    notify('Canvas share failed', msg, error=True)
    print(f'canvas-share: {msg}', file=sys.stderr)
    sys.exit(code)


def notify(summary, body, error=False):
    # Best-effort desktop notification; never fails the share itself.
    try:
        subprocess.run(
            ['notify-send', '-a', 'Canvas', '-i', 'dialog-error' if error else 'document-send', summary, body],
            check=False, capture_output=True, timeout=5,
        )
    except Exception:
        pass


def load_config():
    if not CONF.exists():
        die(f'no config at {CONF} — create it with CANVAS_URL and CANVAS_TOKEN (see README)')
    cfg = {}
    for line in CONF.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith('#') or '=' not in line:
            continue
        key, _, value = line.partition('=')
        cfg[key.strip()] = value.strip().strip('"').strip("'")
    for required in ('CANVAS_URL', 'CANVAS_TOKEN'):
        if not cfg.get(required):
            die(f'{required} missing in {CONF}')
    cfg.setdefault('CANVAS_WORKSPACE', 'universe')
    cfg.setdefault('CANVAS_PATH', '/')
    cfg.setdefault('CANVAS_TREE', 'context')
    return cfg


def request(cfg, method, path, body, content_type):
    url = f"{cfg['CANVAS_URL'].rstrip('/')}/rest/v2{path}"
    req = urllib.request.Request(url, data=body, method=method, headers={
        'Authorization': f"Bearer {cfg['CANVAS_TOKEN']}",
        'Content-Type': content_type,
    })
    try:
        with urllib.request.urlopen(req, timeout=120) as res:
            return json.loads(res.read().decode('utf-8'))
    except urllib.error.HTTPError as e:
        detail = e.read().decode('utf-8', 'replace')[:300]
        die(f'{method} {path} -> HTTP {e.code}: {detail}')
    except urllib.error.URLError as e:
        die(f'cannot reach {url}: {e.reason}')


def insert_documents(cfg, documents):
    payload = json.dumps({
        'documents': documents,
        'treeNameOrTreeId': cfg['CANVAS_TREE'],
        'treeType': 'context',
        'context': cfg['CANVAS_PATH'],
    }).encode('utf-8')
    request(cfg, 'POST', f"/workspaces/{cfg['CANVAS_WORKSPACE']}/documents", payload, 'application/json')


def share_files(cfg, paths):
    docs = []
    for p in paths:
        path = Path(p)
        if not path.is_file():
            die(f'not a file: {p}')
        data = path.read_bytes()
        blob = request(cfg, 'POST', f"/workspaces/{cfg['CANVAS_WORKSPACE']}/blobs", data,
                       'application/octet-stream')['payload']
        mime = mimetypes.guess_type(path.name)[0] or 'application/octet-stream'
        docs.append({
            'schema': 'data/schema/file',
            'schemaVersion': '2.0',
            'data': {},
            'checksumArray': [f"sha256/{blob['checksum']}"],
            'locations': [{'url': blob['url'], 'metadata': {'filename': path.name}}],
            'metadata': {'contentType': mime, 'size': blob['size']},
        })
    insert_documents(cfg, docs)
    names = ', '.join(Path(p).name for p in paths[:3]) + ('…' if len(paths) > 3 else '')
    notify('Sent to Canvas', f"{len(paths)} file(s) → {cfg['CANVAS_WORKSPACE']}:{cfg['CANVAS_PATH']} ({names})")


def is_bare_url(text):
    return text.startswith(('http://', 'https://')) and not any(c.isspace() for c in text)


def share_text(cfg, text):
    text = text.strip()
    if not text:
        die('nothing to share (empty selection/text)')
    if is_bare_url(text):
        doc = {'schema': 'data/schema/tab', 'schemaVersion': '2.0', 'data': {'url': text}}
        label = 'link'
    else:
        title = text.splitlines()[0][:80]
        doc = {'schema': 'data/schema/note', 'schemaVersion': '2.0', 'data': {'title': title, 'content': text}}
        label = 'note'
    insert_documents(cfg, [doc])
    notify('Sent to Canvas', f"{label} → {cfg['CANVAS_WORKSPACE']}:{cfg['CANVAS_PATH']}")


def read_selection():
    # Wayland first, X11 fallback — the PRIMARY selection (highlighted text).
    for cmd in (['wl-paste', '--primary', '--no-newline'], ['xclip', '-o', '-selection', 'primary']):
        try:
            out = subprocess.run(cmd, capture_output=True, timeout=5)
            if out.returncode == 0 and out.stdout:
                return out.stdout.decode('utf-8', 'replace')
        except FileNotFoundError:
            continue
        except Exception:
            continue
    die('no selection tool found (install wl-clipboard or xclip)')


def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__)
        return 0
    cfg = load_config()
    if argv[0] == '--selection':
        share_text(cfg, read_selection())
    elif argv[0] == '--text':
        rest = argv[1:]
        text = sys.stdin.read() if rest == ['-'] or not rest else ' '.join(rest)
        share_text(cfg, text)
    else:
        share_files(cfg, argv)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
